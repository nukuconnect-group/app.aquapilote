# Redirections pour SPA - Compatible avec tous les navigateurs y compris iOS Safari

# Forcer HTTPS (si domaine personnalisé)
http://*  https://:splat  301!
http://aquapilote.app/*       https://aquapilote.app/:splat       301!
http://www.aquapilote.app/*   https://www.aquapilote.app/:splat   301!
https://www.aquapilote.app/*  https://aquapilote.app/:splat       301!

# Headers de sécurité et cache
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  
# Cache pour les assets statiques
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pas de cache pour index.html et manifest (important pour iOS)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Rediriger toutes les routes applicatives vers index.html pour le routing côté client
/*    /index.html    200